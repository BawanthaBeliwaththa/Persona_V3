# ==========================================
# Persona V3 — Environment Configuration
# ==========================================

# Server Host & Port
HOST=0.0.0.0
PORT=8000
RELOAD=false

# LinkedIn Scraper Credentials
LINKEDIN_EMAIL=your_linkedin_email@example.com
LINKEDIN_PASSWORD=your_linkedin_password

# Or Cookie Authentication (Recommended for 2FA accounts)
LINKEDIN_LI_AT=your_li_at_cookie_value_here

# Browser Settings
# Set HEADLESS=true for Linux/VPS server, HEADLESS=false for local visual debugging
HEADLESS=true

# Task Bucket Worker Rest Timer (seconds)
REST_SECONDS=30

# Optional OpenAI API Key for fallback parsing
OPENAI_API_KEY=
